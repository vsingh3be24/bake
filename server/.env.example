# NODE_ENV=production on Render (not set here — Render sets it directly, and
# it must be exact: cookies switch to SameSite=None + Secure only when it's
# literally "production", which is also what the Part K length/CLIENT_URL
# checks below key off).
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lucky-home-harvest

# Must be two DIFFERENT random values, 32+ chars each — the server refuses to
# start if they are missing or identical, because sharing one secret would let
# a customer token verify as an owner token.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CUSTOMER_JWT_SECRET=change_me_to_a_random_32plus_char_secret
OWNER_JWT_SECRET=change_me_to_a_different_random_32plus_char_secret
JWT_EXPIRY=7d

OWNER_PHONE=8017853043
# bcrypt hash (cost 12). Leave blank and the seed script generates a password
# and prints it once.
OWNER_PASSWORD_HASH=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Exact origin allowed by CORS — required in production. No trailing slash.
# Local:      http://localhost:5173
# Production: https://<your-app>.vercel.app
CLIENT_URL=http://localhost:5173

# Shop's wall-clock timezone. Delivery days, slot cut-offs and every analytics
# bucket are computed in this zone, not the server's.
SHOP_TIMEZONE=Asia/Kolkata

# Web Push (owner → customer broadcast notifications). Optional — without
# these, the "Send Announcement" screen shows a clear "not set up" message
# instead of failing silently. Generate a pair once and keep it forever;
# rotating it invalidates every customer's existing subscription.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
